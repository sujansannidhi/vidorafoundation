---
/**
 * The rule that opens a section: the eyebrow, with a hairline across the top.
 *
 * It used to carry an index numeral on the right as well. Those were removed
 * across the site: they numbered a sequence the reader had no use for.
 */
interface Props {
  eyebrow: string;
}
const { eyebrow } = Astro.props;
---
<div class="section-index">
  <p class="eyebrow">{eyebrow}</p>
</div>
