---
/**
 * Something the organisation has not published yet, stated plainly in the
 * interface instead of invented or left as a silent blank.
 *
 * Brand skill hard rule 3: never fabricate. The wording a visitor sees is
 * public-facing (`what` is written for the reader, for example "Registration
 * opens with the first Drop."), and every use is tracked in the README open
 * register by `item`. It disappears when the content is supplied.
 */
interface Props {
  /** What the reader should know, in plain public language. */
  what: string;
  /** Open register item number. Not shown; kept for the README. */
  item?: number;
}
const { what } = Astro.props;
---
<p class="soon" role="note">
  <span class="soon__label">Coming soon</span>
  <span class="soon__what">{what}</span>
</p>

<style>
  .soon {
    display: grid;
    gap: 2px;
    margin-block: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-left: 2px solid var(--rule);
    max-width: var(--measure);
  }
  .soon__label {
    font-family: var(--font-body);
    font-size: var(--step-utility);
    text-transform: uppercase;
    letter-spacing: var(--tracking-utility);
    font-weight: 700;
    color: var(--link);
  }
  .soon__what { font-size: var(--step-body-sm); color: var(--text-soft); }
</style>
