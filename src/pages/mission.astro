---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { org, values } from '../content/site.ts';
import { foundingNote } from '../content/people.ts';
import { teamAtTheSupplyTable } from '../content/photos.ts';
import { gapFigures, findings, voices, sources } from '../content/mission.ts';

const sourceUrl = (id: number) => sources.find((s) => s.id === id)?.url ?? '#sources';
---
<Layout
  title="Mission"
  description="What Vidora Foundation does, the gap it fills, and the values it works by."
>
  <PageHeader
    variant="dark"
    eyebrow="Mission and vision"
    title="Educational materials, into the hands of students who need them."
    standfirst="Vidora Foundation is organised into chapters. A chapter raises what a school's kits cost and runs the distribution, wherever that school is. Learning Kits is running now. Teaching and Access are what comes next."
  />

  <div class="shell">
    <div class="split">
      <h2 class="split__heading">The gap, plainly.</h2>
      <div class="split__body">
        <p>
          A student is usually not missing everything. They are missing one
          specific thing their year of the syllabus assumes they have. That
          gap is narrow enough to name and cheap enough to buy, which is why a
          student run organisation can close it.
        </p>
        {/* The state scheme is context for the first campaign, not the
            organisation's universal thesis. What a kit contains is decided
            against the grade being taught and against what a student already
            has, which differs from place to place. */}
        <p class="is-quiet">
          What that thing is depends on where the school is. In Andhra
          Pradesh, where the first campaign ran, the state scheme already
          supplies uniforms, shoes, a school bag, textbooks and generic
          notebooks. What it leaves out is a compass box, an atlas, a slate,
          and a notebook matched to a student's grade. Those became the kit.
        </p>
      </div>
    </div>

    <section class="evidence" aria-labelledby="evidence-heading">
      <h2 id="evidence-heading" class="evidence__heading">What the gap looks like, and what the evidence says.</h2>

      <ul class="figures">
        {gapFigures.map((f) => (
          <li class="figure">
            <p class="figure__value">{f.value}</p>
            <p class="figure__label">
              {f.label}<a class="ref" href={`#source-${f.source}`} aria-label={`Source ${f.source}`}><sup>{f.source}</sup></a>
            </p>
          </li>
        ))}
      </ul>

      <div class="findings">
        {findings.map((f) => (
          <article class="finding">
            <h3 class="finding__heading">{f.heading}</h3>
            <div class="finding__body">
              {f.paragraphs.map((para, i) => (
                <p>
                  {para}
                  {i === f.paragraphs.length - 1 && (
                    <sup class="refs">
                      {f.sources.map((id, j) => (
                        <>{j > 0 && ', '}<a class="ref" href={`#source-${id}`} aria-label={`Source ${id}`}>{id}</a></>
                      ))}
                    </sup>
                  )}
                </p>
              ))}
            </div>
          </article>
        ))}
      </div>

      <div class="voices">
        {voices.map((v) => (
          <figure class="voice">
            <blockquote class="voice__quote" cite={sourceUrl(v.source)}>
              <p>{v.quote}</p>
            </blockquote>
            <figcaption class="voice__who">
              <span class="voice__name">{v.who}</span>
              <span class="voice__where">{v.where}<a class="ref" href={`#source-${v.source}`} aria-label={`Source ${v.source}`}><sup>{v.source}</sup></a></span>
            </figcaption>
          </figure>
        ))}
      </div>

      <ol class="sources" id="sources" aria-label="Sources">
        {sources.map((src) => (
          <li id={`source-${src.id}`}>
            {src.citation} <a href={src.url} rel="noopener">Source</a>
          </li>
        ))}
      </ol>
    </section>

    <h2 class="values__heading">What the organisation values</h2>
    <ol class="values">
      {values.map((value) => (
        <li class="value">
          <p class="value__name">{value.name}</p>
          <p class="value__body">{value.body}</p>
        </li>
      ))}
    </ol>

    <div class="who">
      <PhotoSlot
        photo={teamAtTheSupplyTable}
        sizes="(max-width: 48rem) calc(100vw - 2.25rem), 520px"
        ratio="4 / 3"
      />
      <div>
        <h2 class="who__heading">Who runs it</h2>
        <p>{foundingNote}</p>
        <p class="is-quiet">The first chapter is in {org.basedIn}. The first campaign ran in {org.firstCampaignIn}.</p>
        <a class="link-action" href="/people">Meet the team</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--space-md), 4vw, 4rem);
  }
  .split__heading { max-width: 20ch; font-size: clamp(1.7rem, 1rem + 2.6vw, 2.7rem); }
  .split__body { display: grid; gap: var(--space-md); align-content: start; }
  .split__body p { margin: 0; font-size: var(--step-body-lg); max-width: 34rem; }
  .split__body p.is-quiet { font-size: var(--step-body-sm); color: var(--text-soft); }

  /* ---- The evidence ---- */
  .evidence { margin-top: clamp(3.5rem, 9vh, 6.25rem); }
  .evidence__heading {
    max-width: 24ch;
    padding-top: var(--space-md);
    border-top: var(--hairline) solid var(--rule-accent);
    font-size: clamp(1.7rem, 1rem + 2.6vw, 2.7rem);
  }

  .figures {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--hairline);
    background: var(--rule-quiet);
  }
  .figure { max-width: none; background: var(--paper); padding: var(--space-lg) var(--space-md) var(--space-lg) 0; }
  .figure + .figure { padding-left: var(--space-md); }
  .figure__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-stat-sm);
    line-height: 1;
    color: var(--text);
  }
  .figure__label { margin: var(--space-sm) 0 0; font-size: var(--step-body-sm); color: var(--text-soft); max-width: 22rem; }

  .findings { margin-top: clamp(2.5rem, 7vh, 4.5rem); display: grid; gap: clamp(2rem, 5vh, 3.25rem); }
  .finding {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(var(--space-md), 4vw, 4rem);
    padding-top: clamp(1.5rem, 4vh, 2.25rem);
    border-top: var(--hairline) solid var(--rule-quiet);
  }
  .finding__heading { font-size: var(--step-display-4); max-width: 20ch; line-height: 1.3; }
  .finding__body { display: grid; gap: var(--space-md); }
  .finding__body p { margin: 0; max-width: 38rem; }
  .finding__body p + p { color: var(--text-soft); font-size: var(--step-body-sm); }

  .ref { text-decoration: none; color: var(--link); margin-left: 1px; }
  .ref sup { font-size: 0.7em; font-weight: 600; }
  .refs { margin-left: 2px; font-size: 0.7em; font-weight: 600; color: var(--link); }
  .ref:hover { text-decoration: underline; }

  .voices {
    margin-top: clamp(3rem, 8vh, 5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(var(--space-lg), 4vw, 4rem);
  }
  .voice { margin: 0; padding-left: var(--space-md); border-left: 2px solid var(--accent-fill); }
  .voice__quote { margin: 0; }
  .voice__quote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1rem + 1.2vw, 1.9rem);
    line-height: 1.3;
    max-width: 26ch;
  }
  .voice__who { margin-top: var(--space-md); display: grid; gap: 2px; font-size: var(--step-body-sm); }
  .voice__name { font-weight: 600; }
  .voice__where { color: var(--text-soft); }

  .sources {
    margin: clamp(3rem, 8vh, 4.5rem) 0 0;
    padding: var(--space-md) 0 0 1.25rem;
    border-top: var(--hairline) solid var(--rule-quiet);
    display: grid;
    gap: var(--space-xs);
    font-size: var(--step-body-xs);
    color: var(--text-soft);
  }
  .sources li { max-width: 60rem; scroll-margin-top: 6rem; }
  .sources a { color: var(--link); }

  .values__heading {
    margin-top: clamp(3.5rem, 9vh, 6.25rem);
    padding-top: var(--space-md);
    border-top: var(--hairline) solid var(--rule-accent);
    font-size: clamp(1.6rem, 1rem + 2.2vw, 2.3rem);
  }
  .values {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--hairline);
    background: var(--rule-quiet);
  }
  .value { max-width: none; background: var(--paper); padding: var(--space-lg) var(--space-md); }
  .value__name { margin: 0; font-family: var(--font-display); font-size: 1.24rem; }
  .value__body { margin: var(--space-xs) 0 0; font-size: var(--step-body-sm); color: var(--text-soft); }

  .who {
    margin-top: clamp(3.5rem, 9vh, 6.25rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(var(--space-md), 4vw, 3.375rem);
    align-items: center;
  }
  .who__heading { font-size: clamp(1.5rem, 1rem + 1.8vw, 2.1rem); margin-bottom: var(--space-sm); }
  .is-quiet { color: var(--text-soft); font-size: var(--step-body-sm); }

  @media (max-width: 48rem) {
    .split, .who, .finding, .voices, .figures { grid-template-columns: minmax(0, 1fr); }
    .figure, .figure + .figure { padding: var(--space-md) 0; }
  }
</style>
