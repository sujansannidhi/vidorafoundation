---
/**
 * The passage from the navy section into the cream one before the film.
 *
 * It used to carry a centred claim. Now it is only the horizon: navy at the
 * top, dawn through the middle, cream at the bottom. Decorative, so it is
 * hidden from assistive tech and holds no text.
 */
---
<div class="turn" aria-hidden="true"></div>

<style>
  .turn {
    position: relative;
    z-index: 1;
    margin-top: -1px;
    height: clamp(14rem, 42vh, 26rem);
    /* The stops are uneven on purpose: an even ramp reads as a UI gradient,
       this one reads as a horizon. */
    background: linear-gradient(
      to bottom,
      var(--plum) 0%,
      var(--plum) 18%,
      var(--dawn-mid) 42%,
      var(--dawn-warm) 66%,
      var(--copper-text-on-dark) 86%,
      var(--blush) 100%
    );
  }
</style>
