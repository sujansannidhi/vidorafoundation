---
/**
 * The one page shell. Static output, so the head is real HTML in the
 * response body: crawlers and link unfurlers get content, not an empty shell.
 *
 * Fonts are self-hosted rather than fetched from Google, which is why the
 * weights are enumerated: only the six faces the design actually uses ship.
 */
import '@fontsource/source-sans-3/latin-300.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-400-italic.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '@fontsource/libre-baskerville/latin-400.css';
import '@fontsource/libre-baskerville/latin-400-italic.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { org, todos } from '../content/site.ts';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  /**
   * Set on the homepage, which paints its own full-bleed backgrounds and
   * manages its own vertical rhythm rather than sitting in a padded column.
   */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const fullTitle = title === org.name ? org.name : `${title} | ${org.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og/default.png', Astro.site);

/*
 * Organization markup, homepage only. Google's guidance is to describe the
 * organisation once, on one page, rather than to repeat the same entity on
 * every route; the homepage is the page it names. Every value is read from
 * site.ts, so the structured data cannot state something the visible copy
 * contradicts.
 */
const isHome = Astro.url.pathname === '/';
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: org.name,
  url: new URL('/', Astro.site).href,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/brand/favicon-512.png', Astro.site).href,
    width: 512,
    height: 512,
  },
  image: ogImage.href,
  description: org.summary,
  slogan: org.motto,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Frisco',
    addressRegion: 'TX',
    addressCountry: 'US',
  },
  ...(todos.contactEmail ? { email: todos.contactEmail } : {}),
  ...(todos.socialHandles ? { sameAs: todos.socialHandles.map((s) => s.href) } : {}),
};
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: org.name,
  url: new URL('/', Astro.site).href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!--
      The mark itself, square and on the brand cream, at the sizes Google's
      favicon crawler accepts (a multiple of 48px, square, at a stable URL).
      /favicon.ico is listed first and also sits at the site root, which is
      where a crawler looks when it ignores the head.
    -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/brand/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/brand/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/brand/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={org.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {isHome && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1" class={bare ? '' : 'page-main'}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Inner pages sit in a padded column. The homepage opts out with `bare`
     and paints its own bands edge to edge. */
  .page-main { padding-block: var(--section-y) var(--section-y-lg); }
</style>
