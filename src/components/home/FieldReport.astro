---
/**
 * Section 08. The June 2026 campaign as seven stops, beside the photographs.
 *
 * The stops come from campaign-june-2026.ts, so this section and the full
 * report at /campaigns/learning-kits-june-2026 cannot diverge. The last stop
 * has no body and renders its TodoNote here exactly as it does there: the
 * stop that admits what ran tight is the one that makes the other six
 * credible, and hiding it on the homepage would be choosing the marketing
 * version for the page most people read.
 */
import SectionIndex from '../SectionIndex.astro';
import PhotoSlot from '../PhotoSlot.astro';
import TodoNote from '../TodoNote.astro';
import { fieldReportSection } from '../../content/home.ts';
import { stops, campaign } from '../../content/campaign-june-2026.ts';

/* One line per stop on the homepage. The full report carries every
   paragraph; this is the summary view, so it takes the first. */
const summary = stops.map((stop) => ({
  marker: stop.marker,
  heading: stop.heading,
  line: stop.body[0] ?? null,
  todo: stop.todo ?? null,
}));
---
<section class="band field" id={fieldReportSection.id} aria-labelledby="field-heading">
  <div class="shell">
    <SectionIndex eyebrow={fieldReportSection.eyebrow} index={fieldReportSection.index} />

    <div class="field__intro">
      <h2 id="field-heading" class="field__headline">{fieldReportSection.headline}</h2>
      <p class="field__standfirst">{fieldReportSection.standfirst}</p>
    </div>

    <div class="field__grid">
      <ol class="field__stops">
        {summary.map((stop) => (
          <li class="stop reveal--x">
            <p class="stop__marker" aria-hidden="true">{stop.marker}</p>
            <div class="stop__text">
              <h3>{stop.heading}</h3>
              {stop.line && <p class="stop__line">{stop.line}</p>}
              {stop.todo && <TodoNote what={stop.todo} item={5} />}
            </div>
          </li>
        ))}
        <li class="field__more">
          <a class="link-action" href={`/campaigns/${campaign.slug}`}>Read the full field report</a>
        </li>
      </ol>

      <div class="field__photos">
        <div class="field__photo field__photo--tall reveal--wipe">
          <PhotoSlot subject={fieldReportSection.photos[0]} ratio="3 / 4" />
        </div>
        <div class="field__photo-pair">
          <div class="field__photo reveal--wipe">
            <PhotoSlot subject={fieldReportSection.photos[1]} ratio="1 / 1" />
          </div>
          <div class="field__photo reveal--wipe">
            <PhotoSlot subject={fieldReportSection.photos[2]} ratio="1 / 1" />
          </div>
        </div>
        <p class="field__photo-note">{fieldReportSection.photoNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .field__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--space-md), 4vw, 3.75rem);
    margin-top: var(--space-lg);
  }
  .field__headline { max-width: 20ch; }
  .field__standfirst { margin: 0; align-self: end; font-size: var(--step-body-lg); max-width: 34rem; }

  .field__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(1.875rem, 4vw, 3.375rem);
    margin-top: clamp(2.75rem, 7vh, 5.25rem);
  }

  .field__stops { list-style: none; margin: 0; padding: 0; }
  .stop {
    max-width: none;
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-top: var(--hairline) solid var(--rule-quiet);
  }
  .stop__marker { font-family: var(--font-display); font-size: var(--step-body-sm); color: var(--link); margin: 0; }
  .stop h3 { font-size: 1.22rem; letter-spacing: -0.01em; }
  .stop__line { margin: var(--space-xs) 0 0; font-size: var(--step-body-sm); color: var(--text-soft); max-width: 34rem; }
  .field__more {
    max-width: none;
    padding-top: var(--space-md);
    border-top: var(--hairline) solid var(--rule-quiet);
  }

  .field__photos { display: grid; gap: var(--space-sm); align-content: start; }
  .field__photo-pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-sm); }
  .field__photo-note { margin: 0; font-size: var(--step-body-xs); color: var(--text-softer); }

  @media (max-width: 56.25rem) {
    .field__intro,
    .field__grid { grid-template-columns: minmax(0, 1fr); }
    /* Photographs lead on narrow screens: a column of seven text rows before
       any image is a wall. */
    .field__photos { order: -1; }
  }
</style>
