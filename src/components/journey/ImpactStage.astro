---
/**
 * Stage 4. What it cost and what it reached.
 *
 * Three figures, three separate components, three separate labels. There is no
 * array here and no total. The digits do NOT animate: they are correct on
 * arrival, and the copper rule beneath each one draws instead. An animated
 * counter shows a wrong number on every frame but the last.
 */
import ImpactFigure from '../ImpactFigure.astro';
import { studentsWhoReceivedKits, schoolsReached, campaignCost, methodologyNote } from '../../content/impact.ts';
import { stage4 } from '../../content/journey.ts';
---
<section class="impact-stage" id={stage4.id} data-stage="4">
  <div class="shell">
    <div class="impact-stage__meta">
      <p class="eyebrow">{stage4.eyebrow}</p>
      <p class="impact-stage__index" aria-hidden="true">04</p>
    </div>
    <h2 class="impact-stage__headline">{stage4.headline}</h2>

    <div class="impact-stage__figures">
      <ImpactFigure figure={studentsWhoReceivedKits} />
      <ImpactFigure figure={schoolsReached} />
      <ImpactFigure figure={campaignCost} />
    </div>

    <p class="impact-stage__method">{methodologyNote}</p>

    <ul class="impact-stage__excludes">
      <li>{studentsWhoReceivedKits.excludes}</li>
      <li>{schoolsReached.excludes}</li>
      <li>{campaignCost.excludes}</li>
    </ul>
  </div>
</section>

<style>
  .impact-stage { position: relative; z-index: 1; padding-block: var(--space-3xl); }
  .impact-stage__meta {
    display: flex; align-items: baseline; justify-content: space-between;
    border-top: var(--hairline) solid var(--rule); padding-top: var(--space-sm);
  }
  .impact-stage__index { font-family: var(--font-display); font-size: var(--step-display-4); opacity: 0.4; margin: 0; }
  .impact-stage__headline { margin-top: var(--space-lg); max-width: 16ch; }
  .impact-stage__figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
  }
  .impact-stage__method {
    margin-top: var(--space-2xl);
    font-size: var(--step-body-sm);
    max-width: 46rem;
  }
  .impact-stage__excludes {
    list-style: none; padding: 0; margin: var(--space-md) 0 0;
    display: grid; gap: var(--space-xs);
  }
  .impact-stage__excludes li {
    font-size: var(--step-body-sm); opacity: 0.75;
    padding-left: var(--space-md); border-left: var(--hairline) solid var(--rule);
    max-width: 46rem;
  }
</style>
