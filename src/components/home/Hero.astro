---
/**
 * The opening screen: the name, split across the screen, and an open book
 * under the mark's sunburst.
 *
 * On scroll the screen pins. The book's two pages lift and fold into the two
 * halves of an arch, the arch becomes a window, and photographs from the
 * June 2026 distribution flick past inside it, fast, while it widens to fill
 * the screen. It lands on the last photograph, which then lifts up and away,
 * and a short statement sharpens into focus on the navy beneath, word by word.
 *
 * Built in two layers so that nothing depends on the animation:
 *
 * - Without the `motion` class on <html> (no JavaScript, or the reader asked
 *   for reduced motion) this is a plain opening screen with the book drawn
 *   in SVG, followed by the last photograph as an ordinary full-width block
 *   with the statement below it. The flicker frames are not shown or fetched.
 * - With it, the photograph block is lifted into the pinned screen and
 *   clipped to the arch, and the script at the foot of this file drives it.
 *
 * The book, page edges and rays quote the mark's geometry. The mark itself
 * is never stretched or animated.
 */
import { hero } from '../../content/home.ts';
import { heroStudentsWithKits as photo, heroFrames } from '../../content/photos.ts';

const letters = (word: string) => [...word];
const words = hero.statement.split(' ');

/*
 * The emblem is drawn in units of the arch's width: the arch is 100 wide and
 * 124 tall, its base centred on the book's spine at (0, 0). The viewBox runs
 * from 170 left of the spine to 170 right, and from 170 above it to 20
 * below, which holds the rays and the page edges that dip under the spine.
 * The CSS sizes the svg in the same units, so the arch drawn here and the
 * arch the photograph is clipped to are the same shape.
 */
const LEFT_PAGE = 'M 0 -6 C -38 -34 -92 -38 -136 -20 L -138 -4 C -94 -22 -42 -18 0 4 Z';
const RIGHT_PAGE = 'M 0 -6 C 38 -34 92 -38 136 -20 L 138 -4 C 94 -22 42 -18 0 4 Z';
const EDGES = [
  { d: 'M -2 12 C -50 -4 -116 -6 -164 18', cls: 'outer' },
  { d: 'M 2 12 C 50 -4 116 -6 164 18', cls: 'outer' },
  { d: 'M -2 6 C -40 -8 -96 -10 -142 6', cls: 'inner' },
  { d: 'M 2 6 C 40 -8 96 -10 142 6', cls: 'inner' },
];
/* Lines of type on each page, following the curve of its top edge. */
const LINES = [
  'M -16 -16 C -42 -30 -80 -32 -112 -22',
  'M -20 -8 C -46 -22 -82 -24 -116 -14',
  'M 16 -16 C 42 -30 80 -32 112 -22',
  'M 20 -8 C 46 -22 82 -24 116 -14',
];
/* The sunburst: short strokes in a ring outside the arch. */
const RAYS = Array.from({ length: 11 }, (_, i) => {
  const angle = (Math.PI * (15 + i * 15)) / 180;
  const r1 = 134;
  const r2 = i % 2 === 0 ? 162 : 152;
  const p = (r: number) => [-Math.cos(angle) * r, -Math.sin(angle) * r].map((n) => n.toFixed(1));
  const [x1, y1] = p(r1);
  const [x2, y2] = p(r2);
  return `M${x1} ${y1} L${x2} ${y2}`;
});
---
<script is:inline>
  /* Decide before the hero is parsed, so nothing renders and then jumps.
     If the motion script has not started within four seconds (blocked, or
     on a very slow connection) the class comes off again and the page
     shows its still version. */
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var root = document.documentElement;
    root.classList.add('motion');
    /* The opening is a sequence that starts at the top. Restoring a scroll
       position from an earlier visit would drop the reader in the middle
       of it, with half the pieces already moved. */
    if ('scrollRestoration' in history && !location.hash) {
      history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
    }
    setTimeout(function () {
      if (!window.__vidoraMotion) root.classList.remove('motion');
    }, 4000);
  })();
</script>

<section class="hero" id={hero.id} aria-labelledby="hero-heading" data-hero>
  <div class="hero__pin" data-hero-pin>
    <div class="hero__stage" data-hero-stage>
      <h1 id="hero-heading" class="visually-hidden">{hero.wordLeft} {hero.wordRight}</h1>
      <p class="hero__word hero__word--left" aria-hidden="true" data-hero-word="left">
        {letters(hero.wordLeft).map((l) => <span class="hero__letter">{l}</span>)}
      </p>
      <p class="hero__word hero__word--right" aria-hidden="true" data-hero-word="right">
        {letters(hero.wordRight).map((l) => <span class="hero__letter">{l}</span>)}
      </p>

      <div class="hero__center" aria-hidden="true">
        <div class="hero__fig">
          {/* Measured, never seen: the arch the photograph is clipped to. */}
          <div class="hero__arch" data-hero-arch></div>
          <svg class="hero__emblem" viewBox="-170 -170 340 190" focusable="false" data-hero-emblem>
            <g class="hero__rays">
              {RAYS.map((d) => <path d={d} pathLength="100" data-hero-ray />)}
            </g>
            <g class="hero__edges">
              {EDGES.map((e) => <path class={`edge edge--${e.cls}`} d={e.d} pathLength="1000" data-hero-edge />)}
            </g>
            <path class="hero__page" d={LEFT_PAGE} data-hero-page="left" />
            <path class="hero__page" d={RIGHT_PAGE} data-hero-page="right" />
            <g class="hero__lines">
              {LINES.map((d) => <path d={d} pathLength="100" data-hero-line />)}
            </g>
          </svg>
        </div>
      </div>

      <div class="hero__foot" data-hero-fade>
        <a class="btn btn--primary hero__pill" href={hero.pill.href}>{hero.pill.label}</a>
      </div>

      <p class="hero__cue" aria-hidden="true" data-hero-fade>
        <span>{hero.scrollCue}</span>
        <span class="hero__cue-line"></span>
      </p>
    </div>

    <div class="hero__window" data-hero-window>
      <div class="hero__window-inner" data-hero-window-inner>
        {heroFrames.map((f) => (
          <img
            class="hero__frame"
            data-src={f.src}
            data-srcset={f.srcset}
            sizes="100vw"
            alt=""
            fetchpriority="low"
            decoding="async"
            data-hero-frame
          />
        ))}
        <img
          class="hero__photo"
          src={photo.src}
          srcset={photo.srcset}
          sizes="100vw"
          width={photo.width}
          height={photo.height}
          alt={photo.alt}
          fetchpriority="high"
          decoding="async"
          data-hero-frame
        />
      </div>

      <div class="hero__statement shell on-dark" data-hero-statement>
        <p class="hero__statement-text" data-hero-statement-text>
          {words.map((w) => <><span class="hero__w">{w}</span>{' '}</>)}
        </p>
        <div class="hero__after" data-hero-after>
          <div class="hero__more">
            {hero.statementMore.map((para) => <p>{para}</p>)}
          </div>
          <div class="hero__actions">
            <a class="btn btn--primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</a>
            <a class="btn btn--secondary" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ================================================================ *
   * Still version. This is what every reader gets before the motion
   * class is considered, and all a reader with reduced motion sees.
   * ================================================================ */
  .hero { position: relative; z-index: 1; background: var(--paper); }

  .hero__stage {
    position: relative;
    min-height: calc(100svh - var(--header-h, 72px));
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: auto auto minmax(14rem, 1fr) auto auto;
    grid-template-areas:
      'left  .'
      'left  .'
      'center center'
      '.     right'
      'foot  foot';
    column-gap: var(--space-lg);
    padding: clamp(1.5rem, 5vh, 3.5rem) var(--gutter) clamp(1.25rem, 3vh, 2rem);
    max-width: calc(var(--shell) + 2 * var(--gutter) + 12rem);
    margin-inline: auto;
    overflow: hidden;
  }

  /* ---- The name ---- */
  .hero__word {
    display: block;
    margin: 0;
    max-width: none;
    pointer-events: none;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 0.9;
    white-space: nowrap;
    will-change: transform, filter;
  }
  .hero__word--left {
    grid-area: left;
    align-self: start;
    font-size: clamp(3.4rem, 1rem + 10.5vw, 11.5rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    margin-left: -0.04em;
  }
  .hero__word--right {
    grid-area: right;
    justify-self: end;
    align-self: end;
    font-size: clamp(3rem, 1rem + 7.4vw, 8.5rem);
    font-style: italic;
    letter-spacing: -0.01em;
    color: var(--link);
    padding-right: 0.06em;
    /* The book's outer pages dip below the arch's base; keep them off the
       ascenders of the word underneath. */
    margin-top: clamp(1.5rem, 2.6vw, 2.75rem);
  }
  .hero__letter { display: inline-block; }

  /* ---- The book and its window ---- */
  .hero__center {
    grid-area: center;
    position: relative;
    container-type: size;
    min-height: 14rem;
    pointer-events: none;
  }
  .hero__fig {
    /* The arch's width, which everything in the emblem is sized from. Three
       limits: the emblem (rays to page edges, 1.84 arch-widths tall) must
       fit the row with room to spare above and below, so it never reaches
       VIDORA or Foundation; it must fit the screen's width, 3.35 arch-widths
       wide; and on a large screen it need not be bigger than this. */
    --aw: min(50cqh, max(22vw, 30vh), calc((100vw - 2 * var(--gutter)) / 3.35));
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    /* Centre the emblem in the row. Its lowest point, the page edges, sits
       0.22 arch-widths below the spine, so the spine is lifted at least
       that far: nothing drawn hangs into the row below. */
    bottom: max(calc(var(--aw) * 0.22), calc((100cqh - var(--aw) * 1.84) / 2 + var(--aw) * 0.22));
  }
  .hero__arch {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: var(--aw);
    height: calc(var(--aw) * 1.24);
    transform: translateX(-50%);
    visibility: hidden;
  }

  /* The emblem, in units of the arch's width (see the frontmatter). Centred
     with `left` rather than a transform, because the scroll animation scales
     it and a percentage translate would be frozen into pixels. */
  .hero__emblem {
    position: absolute;
    left: calc(50% - var(--aw) * 1.7);
    bottom: calc(var(--aw) * -0.2);
    width: calc(var(--aw) * 3.4);
    /* base.css caps every svg at 100% of its parent, which on a phone would
       shrink the emblem and pull it off the arch's centre line. */
    max-width: none;
    height: auto;
    overflow: visible;
  }
  .hero__rays path {
    fill: none;
    stroke: var(--accent-on-dark);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .edge { fill: none; stroke-linecap: round; }
  .edge--outer { stroke: var(--accent-fill); stroke-width: 3.6; }
  .edge--inner { stroke: var(--accent-on-dark); stroke-width: 2.4; }
  .hero__page {
    fill: var(--paper-lift);
    stroke: var(--accent-fill);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .hero__lines path {
    fill: none;
    stroke: var(--rule-quiet);
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  /* ---- Foot of the screen ---- */
  .hero__foot {
    grid-area: foot;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md) var(--space-lg);
    flex-wrap: wrap;
    margin-top: clamp(1rem, 3vh, 2rem);
  }
  .hero__pill { flex: none; }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: clamp(0.75rem, 2vh, 1.25rem);
    transform: translateX(-50%);
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 6px;
    font-size: var(--step-utility-sm);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-softer);
  }
  .hero__cue-line {
    display: block;
    width: 1px;
    height: 26px;
    background: var(--rule);
    transform-origin: top;
  }

  /* ---- The photograph, then the statement on navy below it ---- */
  .hero__window {
    position: relative;
    overflow: hidden;
    background: var(--plum);
  }
  .hero__window-inner { position: relative; height: 78svh; overflow: hidden; }
  .hero__photo,
  .hero__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  /* The flicker frames exist only for the motion version. Their addresses
     sit in data- attributes until its script copies them across, so without
     it they are never fetched. (A lazy image is not enough: with scripting
     off, Chrome loads lazy images straight away.) */
  .hero__frame { display: none; }

  .hero__statement {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: var(--section-y);
    background: none;
  }
  .hero__statement-text {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1rem + 2.6vw, 3.4rem);
    line-height: 1.16;
    letter-spacing: -0.012em;
    color: var(--text);
  }
  .hero__w { display: inline-block; }
  .hero__after { display: grid; gap: var(--space-lg); margin-top: clamp(var(--space-lg), 5vh, var(--space-xl)); }
  .hero__more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) clamp(var(--space-lg), 4vw, 3.5rem);
    max-width: 62rem;
    padding-top: var(--space-md);
    border-top: var(--hairline) solid var(--rule-accent);
  }
  .hero__more p { margin: 0; font-size: var(--step-body); color: var(--text-soft); max-width: 30rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); }

  /* Below this width the cue would crowd the button at the foot. */
  @media (max-width: 75rem) {
    .hero__cue { display: none; }
  }

  /* ---- Phones: the name stacks, the window narrows ---- */
  @media (max-width: 48rem) {
    .hero__stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(12rem, 1fr) auto auto;
      grid-template-areas: 'left' 'center' 'right' 'foot';
    }
    .hero__word--left { font-size: clamp(3rem, 17.5vw, 6rem); letter-spacing: 0.04em; }
    .hero__word--right { font-size: clamp(2.75rem, 15vw, 5.5rem); }
    .hero__fig { --aw: min(50cqh, calc((100vw - 2 * var(--gutter)) / 3.35)); }
    /* The book's outer pages dip below the arch's base: keep them off the
       word underneath. */
    .hero__word--right { margin-top: calc(var(--space-md) + 0.6rem); }
    .hero__foot { flex-direction: column; align-items: flex-start; }
    .hero__cue { display: none; }
    .hero__more { grid-template-columns: minmax(0, 1fr); }
    .hero__more p { font-size: var(--step-body-sm); }
  }

  /* ================================================================ *
   * Motion version. Only under html.motion, which the inline script
   * sets when the reader has not asked for reduced motion.
   * ================================================================ */
  :global(html.motion) .hero__pin {
    position: relative;
    height: calc(100svh - var(--header-h, 72px));
    overflow: hidden;
  }
  :global(html.motion) .hero__stage { height: 100%; min-height: 0; }

  /* The block becomes a layer over the whole screen, clipped to the arch.
     It is invisible until the book has folded into that arch. */
  :global(html.motion) .hero__window {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    display: flex;
    align-items: center;
    background: var(--plum);
  }
  :global(html.motion) .hero__window-inner { position: absolute; inset: 0; height: auto; }
  :global(html.motion) .hero__frame { display: block; }
  :global(html.motion) .hero__window-inner { will-change: transform; }
  /* Transparent rather than hidden, so a screen reader still reaches it. */
  :global(html.motion) .hero__statement {
    opacity: 0;
    padding-block: 1.5rem;
  }
  /* Pinned, the statement has exactly one screen to fit in, so its size
     follows the screen's height as well as its width. */
  :global(html.motion) .hero__statement-text {
    max-width: 24ch;
    font-size: clamp(1.5rem, min(1rem + 2.4vw, 5.6vh), 3.2rem);
  }
  /* Everything that draws or fades in on load starts out of sight. */
  :global(html.motion) .hero__letter,
  :global(html.motion) [data-hero-fade],
  :global(html.motion) .hero__emblem { opacity: 0; }

  /* The book, rays, words and foot sit above the photograph layer. */
  :global(html.motion) .hero__center,
  :global(html.motion) .hero__foot,
  :global(html.motion) .hero__cue { position: relative; z-index: 2; }
  :global(html.motion) .hero__cue { position: absolute; }
  :global(html.motion) .hero__word { position: relative; z-index: 2; }
</style>

<script>
  import { gsap, startSmoothScroll, motionAllowed } from '../../scripts/home-motion.ts';
  import { MorphSVGPlugin } from 'gsap/MorphSVGPlugin';

  gsap.registerPlugin(MorphSVGPlugin);

  const root = document.querySelector<HTMLElement>('[data-hero]');

  if (root && motionAllowed()) {
    const lenis = startSmoothScroll();

    const q = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const qa = <T extends Element = HTMLElement>(sel: string) => Array.from(root.querySelectorAll<T>(sel));

    const pin = q('[data-hero-pin]');
    const arch = q('[data-hero-arch]');
    const windowEl = q('[data-hero-window]');
    const windowInner = q('[data-hero-window-inner]');
    const frames = qa<HTMLImageElement>('[data-hero-frame]');
    const statement = q('[data-hero-statement]');
    const statementWords = qa('.hero__w');
    const after = q('[data-hero-after]');
    const left = q('[data-hero-word="left"]');
    const right = q('[data-hero-word="right"]');
    const letters = qa('.hero__letter');
    const fades = qa('[data-hero-fade]');
    const emblem = q<SVGSVGElement>('[data-hero-emblem]');
    const pageL = q<SVGPathElement>('[data-hero-page="left"]');
    const pageR = q<SVGPathElement>('[data-hero-page="right"]');
    const pages = [pageL, pageR];
    const edges = qa<SVGPathElement>('[data-hero-edge]');
    const lines = qa<SVGPathElement>('[data-hero-line]');
    const rays = qa<SVGPathElement>('[data-hero-ray]');

    /* Each page folds into one half of the arch (100 wide, 124 tall, radius
       50, in the emblem's units). Both start at the top of the spine, which
       becomes the top of the arch, so the morph lifts the page rather than
       turning it inside out. */
    const ARCH_LEFT = 'M 0 -124 C -27.6 -124 -50 -101.6 -50 -74 L -50 0 L 0 0 Z';
    const ARCH_RIGHT = 'M 0 -124 C 27.6 -124 50 -101.6 50 -74 L 50 0 L 0 0 Z';

    /* The header is sticky above the hero. Its height decides how tall the
       pinned screen can be, so it is measured rather than guessed. */
    const header = document.querySelector<HTMLElement>('.site-header');
    const setHeader = () =>
      document.documentElement.style.setProperty('--header-h', `${header?.offsetHeight ?? 72}px`);
    setHeader();

    /** The arch, as an inset() on the full-screen layer. */
    const archClip = () => {
      const a = arch.getBoundingClientRect();
      const p = pin.getBoundingClientRect();
      const r = a.width / 2;
      return `inset(${a.top - p.top}px ${p.right - a.right}px ${p.bottom - a.bottom}px ${a.left - p.left}px round ${r}px ${r}px 0px 0px)`;
    };
    const FULL = 'inset(0px 0px 0px 0px round 0px 0px 0px 0px)';

    // The frames carry their addresses in data- attributes so the still
    // version never fetches them. Here they are needed within a few hundred
    // pixels of scroll: ask for them now, at low priority.
    frames.forEach((f) => {
      if (f.dataset.srcset) f.srcset = f.dataset.srcset;
      if (f.dataset.src) f.src = f.dataset.src;
    });

    gsap.set(windowEl, { clipPath: archClip() });

    /* ---------------- On load: the book draws itself ---------------- */
    const intro = gsap.timeline({ defaults: { ease: 'expo.out' }, delay: 0.15 });
    intro
      .set(emblem, { opacity: 1 })
      .fromTo(edges,
        { strokeDasharray: 1000, strokeDashoffset: 1000 },
        { strokeDashoffset: 0, duration: 1.5, stagger: 0.07, ease: 'power2.inOut' }, 0.1)
      .fromTo(pages,
        { opacity: 0, y: 10 },
        { opacity: 1, y: 0, duration: 1.3, stagger: 0.1, ease: 'power3.out' }, 0.45)
      .fromTo(lines,
        { strokeDasharray: 100, strokeDashoffset: 100 },
        { strokeDashoffset: 0, duration: 1, stagger: 0.08, ease: 'power2.out' }, 0.9)
      .fromTo(rays,
        { strokeDasharray: 100, strokeDashoffset: 100, opacity: 0 },
        { strokeDashoffset: 0, opacity: 1, duration: 1.1, stagger: { each: 0.05, from: 'center' } }, 0.8)
      .fromTo(letters,
        { opacity: 0, yPercent: 18, filter: 'blur(18px)' },
        { opacity: 1, yPercent: 0, filter: 'blur(0px)', duration: 1.5, stagger: 0.045 }, 0.25)
      .fromTo(fades,
        { opacity: 0, y: 14 },
        { opacity: 1, y: 0, duration: 1.1, stagger: 0.08 }, 1.1)
      .fromTo('.hero__cue-line', { scaleY: 0 }, { scaleY: 1, duration: 0.9, ease: 'power2.out' }, 1.5)
      // Clear the filters so they do not hold every letter on its own layer.
      .set(letters, { clearProps: 'filter' });

    /* ---------------- On scroll ---------------- */
    const mm = gsap.matchMedia();
    mm.add({ wide: '(min-width: 48.01rem)', narrow: '(max-width: 48rem)' }, (ctx) => {
      const wide = ctx.conditions?.wide;
      const drift = wide ? 34 : 22;

      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: pin,
          // The header is sticky above the hero, so the screen pins directly
          // under it rather than sliding beneath it first.
          start: () => `top ${header?.offsetHeight ?? 0}px`,
          end: () => `+=${window.innerHeight * (wide ? 3.4 : 2.9)}`,
          pin: true,
          scrub: 1,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onRefresh: setHeader,
        },
      });

      /* 1. The book becomes the window. The pages lift and fold into the two
            halves of the arch; the type on them and the page edges under
            them fall away; then the paper gives way to the first photograph. */
      tl
        .to(pageL, { morphSVG: { shape: ARCH_LEFT, shapeIndex: 0 }, duration: 2.2, ease: 'power2.inOut' }, 0)
        .to(pageR, { morphSVG: { shape: ARCH_RIGHT, shapeIndex: 0 }, duration: 2.2, ease: 'power2.inOut' }, 0)
        .fromTo([...lines, ...edges], { opacity: 1 }, { opacity: 0, duration: 1.1 }, 0.2)
        .fromTo(windowEl, { opacity: 0 }, { opacity: 1, duration: 0.6 }, 1.9)
        .fromTo(pages, { fillOpacity: 1 }, { fillOpacity: 0, duration: 0.6 }, 1.9)
        .fromTo(pages, { strokeOpacity: 1 }, { strokeOpacity: 0, duration: 0.8 }, 2.5)

      /* 2. The window widens to the full screen while the photographs flick
            past inside it, settling from a slight zoom as they go. */
        .fromTo(windowEl, { clipPath: archClip }, { clipPath: FULL, duration: 4.6, ease: 'power2.inOut' }, 2.4)
        .fromTo(windowInner, { scale: 1.22 }, { scale: 1, duration: 5, ease: 'power1.out' }, 2.4)
        .fromTo(emblem,
          { scale: 1, filter: 'opacity(1)' },
          { scale: 2.4, filter: 'opacity(0)', duration: 3, ease: 'power2.in', transformOrigin: '50% 89.47%' }, 2.4);

      /* One frame after another, each for a sliver of the scroll, ending on
         the last photograph, which stays. The frame is worked out from the
         timeline's position on every update rather than with a chain of
         set() calls: zero-length tweens on the same elements do not always
         unwind in order when the scroll jumps back a long way, and a missed
         one leaves every frame hidden. */
      const FIRST = 2.1;
      const STEP = 0.44;
      const landed = FIRST + (frames.length - 1) * STEP;
      // Hold on the last photograph for a moment once the window is full.
      const lift = Math.max(landed + 0.7, 7.3);
      let shown = -1;
      const showFrame = () => {
        const i = Math.min(frames.length - 1, Math.max(0, Math.floor((tl.time() - FIRST) / STEP) + 1));
        if (i === shown) return;
        shown = i;
        frames.forEach((f, j) => { f.style.opacity = j === i ? '1' : '0'; });
      };
      tl.eventCallback('onUpdate', showFrame);
      showFrame();

      /* 3. The name parts and blurs away; the foot of the screen goes. */
      tl
        .fromTo(left,
          { xPercent: 0, x: 0, filter: 'blur(0px)', opacity: 1 },
          { xPercent: -drift, x: () => -window.innerWidth * 0.06, filter: 'blur(14px)', opacity: 0, duration: 3, ease: 'power2.in' }, 1.2)
        .fromTo(right,
          { xPercent: 0, x: 0, filter: 'blur(0px)', opacity: 1 },
          { xPercent: drift, x: () => window.innerWidth * 0.06, filter: 'blur(14px)', opacity: 0, duration: 3, ease: 'power2.in' }, 1.2)
        // `filter: opacity()` rather than `opacity`: the load animation owns
        // opacity on these same elements, and two tweens on one property
        // would each reset the other whenever the page re-measures.
        .fromTo(fades, { filter: 'opacity(1)' }, { filter: 'opacity(0)', duration: 1.2 }, 0)
        .set(fades, { pointerEvents: 'none' }, 1.2)

      /* 4. Once it has landed, the photograph lifts away and the statement
            takes its place. */
        // The last photograph lifts up and away, leaving the navy, and only
        // then does the statement arrive.
        .fromTo(windowInner, { yPercent: 0 }, { yPercent: -100, duration: 1.8, ease: 'power2.inOut' }, lift)
        .set(statement, { opacity: 1 }, lift + 1.2)
        .fromTo(statementWords,
          { opacity: 0.08, filter: 'blur(10px)', yPercent: 12 },
          { opacity: 1, filter: 'blur(0px)', yPercent: 0, duration: 1, stagger: 0.12, ease: 'power2.out' }, lift + 1.3)
        .fromTo(after, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 1.2, ease: 'power2.out' }, '>-0.4')
        // Stillness before the page moves on, long enough to read the
        // buttons before the screen releases.
        .to({}, { duration: 2.2 });

      /* A keyboard reader tabbing into the statement's links would otherwise
         land on them while they are still transparent. Carry the page to
         the point where the statement is fully drawn. */
      const onFocus = () => {
        const st = tl.scrollTrigger;
        if (st && window.scrollY < st.end - 2) lenis?.scrollTo(st.end, { immediate: true });
      };
      statement.addEventListener('focusin', onFocus);

      return () => {
        statement.removeEventListener('focusin', onFocus);
        tl.kill();
      };
    });

    window.addEventListener('resize', setHeader);
  }
</script>
