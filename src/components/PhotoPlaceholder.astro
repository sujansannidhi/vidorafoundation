---
/**
 * A frame waiting for a photograph, stated as such.
 *
 * Used where a real photograph has been asked for but does not exist yet.
 * It says so in words rather than borrowing a stock image, which would show
 * something that has not happened.
 *
 * TODO(mani): each placeholder on the site is listed by `label`; swap in a
 * PhotoSlot once a cleared photograph exists.
 */
interface Props {
  /** What the photograph will show, read by assistive tech and on screen. */
  label: string;
  ratio?: string;
  class?: string;
}
const { label, ratio = '4 / 3', class: className } = Astro.props;
---
<div class:list={['placeholder', className]} style={`aspect-ratio: ${ratio};`} role="img" aria-label={`Photograph to come: ${label}`}>
  <svg class="placeholder__icon" viewBox="0 0 48 36" aria-hidden="true" focusable="false">
    <rect x="1" y="1" width="46" height="34" rx="2" />
    <path d="M1 28 L16 16 L26 25 L33 19 L47 30" />
    <circle cx="35" cy="10" r="3.5" />
  </svg>
  <p class="placeholder__label" aria-hidden="true">Photo to come</p>
</div>

<style>
  .placeholder {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-sm);
    border: var(--hairline) dashed var(--rule-quiet);
    background: rgb(250 247 242 / 0.04);
    color: var(--text-softer);
  }
  .placeholder__icon {
    width: 44px;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .placeholder__label {
    margin: 0;
    font-size: var(--step-utility);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
    font-weight: 600;
    max-width: none;
  }
</style>
