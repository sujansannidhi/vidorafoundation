---
/**
 * Navy footer. The mark, the motto, where the organisation is and where the
 * work is, then the link groups.
 *
 * The 501(c)(3) line renders here through the shared PendingStatus
 * component, in body size, above the copyright rather than tucked under it.
 */
import Mark from './Mark.astro';
import PendingStatus from './PendingStatus.astro';
import TodoNote from './TodoNote.astro';
import { footerNav, org, todos } from '../content/site.ts';
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="shell">
    <div class="site-footer__top">
      <div class="site-footer__brand" id="road-terminus">
        <Mark width={76} tone="light" alt="Vidora Foundation" />
        <p class="site-footer__motto">{org.motto}</p>
        <p class="site-footer__summary">{org.summary}</p>
        <p class="site-footer__where">{org.basedIn}. Operations in {org.operationsIn}.</p>
      </div>

      <nav class="site-footer__nav" aria-label="Footer">
        {footerNav.map((group) => (
          <div class="site-footer__group">
            <h2 class="eyebrow site-footer__heading">{group.heading}</h2>
            <ul>
              {group.links.map((l) => (
                <li><a href={l.href}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="site-footer__contact">
      {todos.contactEmail && <p><a href={`mailto:${todos.contactEmail}`}>{todos.contactEmail}</a></p>}

      {todos.socialHandles && (
        <ul class="site-footer__social">
          {todos.socialHandles.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
        </ul>
      )}

      {/* One note rather than three. They are all the same open item, and
          three stacked boxes read as broken rather than as honest. */}
      {(!todos.contactEmail || !todos.socialHandles || !todos.newsletterProvider) && (
        <TodoNote
          item={4}
          what={[
            !todos.contactEmail && 'a contact email',
            !todos.socialHandles && 'social handles',
            !todos.newsletterProvider && 'a newsletter provider',
          ].filter(Boolean).join(', ').replace(/, ([^,]*)$/, ' and $1')
            + '. Nothing is guessed at and no signup form ships until there is somewhere for an address to go.'}
        />
      )}
    </div>

    <PendingStatus />

    <p class="site-footer__legal">
      &copy; {year} {org.name}. The legal entity is registered as {org.legalEntity};
      {org.name} is the operating name.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    padding-block: clamp(3.5rem, 8vh, 5.625rem) var(--space-lg);
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr);
    gap: clamp(var(--space-lg), 5vw, 4rem);
    align-items: start;
  }
  .site-footer__motto {
    margin: var(--space-md) 0 0;
    font-family: var(--font-display);
    font-size: 1.32rem;
    line-height: 1.35;
    max-width: 22rem;
  }
  .site-footer__summary {
    margin: var(--space-sm) 0 0;
    font-size: var(--step-body-sm);
    color: var(--text-soft);
    max-width: 24rem;
  }
  .site-footer__where {
    margin: var(--space-xs) 0 0;
    font-size: var(--step-body-xs);
    color: var(--text-softer);
    max-width: 24rem;
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: clamp(var(--space-md), 3vw, var(--space-xl));
  }
  .site-footer__heading { color: var(--accent-on-dark); }
  .site-footer__nav ul { list-style: none; margin: var(--space-sm) 0 0; padding: 0; display: grid; gap: 9px; }
  .site-footer__nav li { max-width: none; }
  .site-footer__nav a {
    font-size: var(--step-body-sm);
    color: var(--text-soft);
    text-decoration: none;
  }
  .site-footer__nav a:hover { color: var(--accent-on-dark); text-decoration: underline; }

  .site-footer__contact { margin-top: var(--space-xl); }
  .site-footer__social { list-style: none; padding: 0; display: flex; gap: var(--space-md); }
  .site-footer__legal {
    margin: var(--space-md) 0 0;
    font-size: var(--step-body-sm);
    color: var(--text-softer);
    max-width: var(--measure-wide);
  }

  @media (max-width: 52rem) {
    .site-footer__top { grid-template-columns: minmax(0, 1fr); }
  }
</style>
