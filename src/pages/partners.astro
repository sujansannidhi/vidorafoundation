---
/**
 * Partners: the organisations that have agreed to be listed, and an enquiry
 * form for the ones that would like to be.
 *
 * Only partners who have agreed appear. The enquiry form posts to
 * FormSubmit, which emails it to the team; nothing is stored on this site.
 * With JavaScript the form sends in place and says so; without it, it posts
 * normally and FormSubmit returns the visitor to /partners/thanks.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PendingStatus from '../components/PendingStatus.astro';
import { partners, enquiryPromises, partnershipKinds, enquiryForm } from '../content/partners.ts';

const action = `https://formsubmit.co/${enquiryForm.to}`;
---
<Layout
  title="Partners"
  description="Organisations that work with Vidora Foundation, and how a company can partner with us."
>
  <PageHeader
    eyebrow="Partners"
    title="Partners"
    standfirst="Vidora Foundation works with organisations that stay with us across campaigns, not one distribution at a time."
  />

  <section class="partners-section" aria-labelledby="partners-heading">
    <div class="shell">
      <h2 id="partners-heading" class="partners__title">
        Who we work with, across the whole organisation
      </h2>

      <ul class="partners">
        {partners.map((partner) => (
          <li class="partner" id={`partner-${partner.slug}`}>
            <div class="partner__logo">
              <picture>
                <source srcset={partner.logo.src} type="image/webp" />
                <img
                  src={partner.logo.fallback}
                  width={partner.logo.width}
                  height={partner.logo.height}
                  alt={`${partner.name} logo`}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="partner__text">
              <p class="partner__kind">{partner.kind} · {partner.where}</p>
              <h3 class="partner__name">{partner.name}</h3>
              <p class="partner__body">{partner.body}</p>
              <a class="link-action partner__link" href={partner.link.href} rel="noopener">{partner.link.label}</a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band on-dark enquiry" id="enquiry" aria-labelledby="enquiry-heading">
    <div class="shell">
      <div class="section-index">
        <p class="eyebrow">Partner with us</p>
      </div>

      <div class="enquiry__grid">
        <div class="enquiry__pitch">
          <h2 id="enquiry-heading" class="enquiry__title">
            Tell us which school you want to reach.
          </h2>
          <p class="lede">
            Tell us a school, a grade, or the kind of help you can give, and we
            will take it from there.
          </p>
          <ul class="promises">
            {enquiryPromises.map((promise) => (
              <li><span class="promises__tick" aria-hidden="true"></span><span>{promise}</span></li>
            ))}
          </ul>
          <PendingStatus />
        </div>

        <div class="panel">
          <h3 class="panel__heading">Partnership enquiry</h3>
          <p class="panel__intro">
            This goes straight to our inbox. A sentence or two for each is plenty.
          </p>

          <form class="form" action={action} method="POST" data-enquiry>
            <input type="hidden" name="_subject" value={enquiryForm.subject} />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" value={enquiryForm.next} />
            {/* Left empty by people; filled by bots, which FormSubmit then drops. */}
            <input type="text" name="_honey" class="form__honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="field">
              <label for="enq-name">Your name</label>
              <input id="enq-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="enq-email">Email</label>
              <input id="enq-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="enq-org">Company or organisation</label>
              <input id="enq-org" name="organisation" type="text" autocomplete="organization" required />
            </div>
            <div class="field">
              <label for="enq-kind">Kind of partnership</label>
              <select id="enq-kind" name="partnership" required>
                <option value="" disabled selected>Choose one</option>
                {partnershipKinds.map((k) => <option value={k}>{k}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="enq-message">What you have in mind</label>
              <textarea id="enq-message" name="message" rows="5" required
                placeholder="A school, a district or a grade, if you already have one."></textarea>
            </div>

            <button class="btn btn--accent form__submit" type="submit" data-enquiry-submit>Send enquiry</button>
            <p class="form__status" role="status" aria-live="polite" data-enquiry-status></p>
            <p class="form__note">
              Your message goes straight to our team at {enquiryForm.to}.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { enquiryForm } from '../content/partners.ts';

  /* Send in place, so the visitor stays on the page and sees the result.
     Without this script the form still posts, and FormSubmit sends the
     visitor back to /partners/thanks. */
  const form = document.querySelector<HTMLFormElement>('[data-enquiry]');
  const status = document.querySelector<HTMLElement>('[data-enquiry-status]');
  const submit = document.querySelector<HTMLButtonElement>('[data-enquiry-submit]');

  form?.addEventListener('submit', async (event) => {
    if (!status || !submit) return;
    event.preventDefault();
    submit.disabled = true;
    status.dataset.state = 'sending';
    status.textContent = 'Sending…';
    try {
      const response = await fetch(`https://formsubmit.co/ajax/${enquiryForm.to}`, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const result: { success?: string | boolean; message?: string } = await response.json().catch(() => ({}));
      if (!response.ok || String(result.success) !== 'true') throw new Error(result.message ?? 'Not sent');
      form.reset();
      status.dataset.state = 'sent';
      status.textContent = 'Thank you. Your enquiry is on its way, and we will reply by email.';
    } catch {
      status.dataset.state = 'error';
      status.textContent = `That did not send. Please try again, or email ${enquiryForm.to}.`;
    } finally {
      submit.disabled = false;
    }
  });
</script>

<style>
  /* ---- Partners ---- */
  .partners-section { margin-top: clamp(2.5rem, 7vh, 4.5rem); }
  .partners__title {
    max-width: 24ch;
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2.1rem);
  }
  .partners {
    list-style: none;
    margin: clamp(1.5rem, 4vh, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 34rem), 1fr));
    gap: clamp(0.875rem, 2vw, 1.375rem);
  }
  .partner {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(var(--space-md), 3vw, 2rem);
    background: var(--paper-lift);
    border: var(--hairline) solid var(--rule-quiet);
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
  }
  .partner__logo img { width: 100%; height: auto; }
  .partner__text { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-xs); }
  .partner__kind {
    margin: 0;
    font-size: var(--step-utility-sm);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
    font-weight: 700;
    color: var(--link);
    max-width: none;
  }
  .partner__name { font-size: 1.5rem; letter-spacing: -0.01em; }
  .partner__body { margin: 0; font-size: var(--step-body-sm); color: var(--text-soft); }
  .partner__link { margin-top: var(--space-sm); }

  @media (max-width: 30rem) {
    .partner { grid-template-columns: minmax(0, 1fr); }
    .partner__logo { max-width: 16rem; }
  }

  /* ---- The enquiry band ---- */
  .enquiry { margin-top: clamp(3.5rem, 9vh, 6.875rem); }
  /* The band runs into the footer, with no cream strip between them. */
  :global(main.page-main:has(> .enquiry:last-child)) { padding-bottom: 0; }
  .enquiry__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(1.75rem, 4vw, 4rem);
    margin-top: clamp(1.5rem, 4vh, 2.75rem);
  }
  .enquiry__pitch { display: grid; gap: var(--space-md); align-content: start; }
  .enquiry__title { max-width: 18ch; font-size: clamp(1.8rem, 1rem + 2.9vw, 2.9rem); }
  .enquiry .lede { margin: 0; color: var(--text-soft); max-width: 32rem; }

  .promises { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-sm); }
  .promises li {
    display: flex;
    gap: var(--space-sm);
    align-items: baseline;
    max-width: 34rem;
    font-size: var(--step-body-sm);
    color: var(--text-soft);
  }
  .promises__tick {
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--accent-on-dark);
    transform: translateY(-2px);
  }

  /*
   * The panel is a cream card inside the navy band, so it resets the
   * inverted roles rather than inheriting them. Without this the tokens set
   * by .on-dark would paint cream text on cream paper.
   */
  .panel {
    --surface: var(--paper);
    --text: var(--ink);
    --link: var(--accent-on-light);
    --rule-quiet: rgb(16 42 67 / 0.14);
    --text-soft: rgb(16 42 67 / 0.8);
    --text-softer: rgb(16 42 67 / 0.6);
    background: var(--surface);
    color: var(--text);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    align-self: start;
  }
  .panel__heading { font-size: 1.4rem; letter-spacing: -0.014em; }
  .panel__intro { margin: var(--space-sm) 0 0; font-size: var(--step-body-sm); color: var(--text-soft); }
  /* ---- The form ---- */
  .form { margin-top: var(--space-lg); display: grid; gap: var(--space-md); }
  .field { display: grid; gap: 6px; }
  .field label {
    font-size: var(--step-utility-sm);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    font: inherit;
    font-size: var(--step-body-sm);
    color: var(--text);
    background: var(--paper-lift);
    border: var(--hairline) solid var(--rule-quiet);
    padding: 0.7rem 0.8rem;
    border-radius: 0;
  }
  .field textarea { resize: vertical; min-height: 7rem; }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible { outline: 2px solid var(--accent-fill); outline-offset: 1px; }
  .form__honey { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .form__submit { width: 100%; text-align: center; margin-top: var(--space-xs); }
  .form__submit:disabled { opacity: 0.6; cursor: progress; }
  .form__status { margin: 0; font-size: var(--step-body-sm); color: var(--text); min-height: 1.4em; }
  .form__status:empty { display: none; }
  .form__status[data-state='error'] { color: var(--link); }
  .form__note { margin: 0; font-size: var(--step-body-xs); color: var(--text-softer); }

  @media (max-width: 56.25rem) {
    .enquiry__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
