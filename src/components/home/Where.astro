---
/**
 * Section 06. Two places and the arc between them.
 *
 * The note at the bottom is the point of the section and is not optional:
 * saying where the work happens without saying why it happens there invites
 * the reader to supply their own answer, and the honest answer is family
 * ties rather than a needs assessment.
 */
import SectionIndex from '../SectionIndex.astro';
import { where } from '../../content/home.ts';
---
<section class="band where" id={where.id} aria-labelledby="where-heading">
  <div class="shell">
    <SectionIndex eyebrow={where.eyebrow} index={where.index} />
    <h2 id="where-heading" class="visually-hidden">Where Vidora Foundation works</h2>

    <div class="where__map">
      <svg viewBox="0 0 1000 300" aria-hidden="true" focusable="false" class="where__arc">
        <path class="where__ghost" d="M90 232 C 320 40 680 40 910 232" />
        <path class="where__drawn reveal--draw" pathLength="1000" d="M90 232 C 320 40 680 40 910 232" />
        <circle class="where__pin" cx="90" cy="232" r="7" />
        <circle class="where__pin where__pin--end" cx="910" cy="232" r="7" />
      </svg>

      <div class="where__poles">
        <div class="pole reveal">
          <p class="pole__label">{where.from.label}</p>
          <h3 class="pole__place">{where.from.place}</h3>
          <p class="pole__body">{where.from.body}</p>
        </div>
        <div class="pole pole--end reveal">
          <p class="pole__label">{where.to.label}</p>
          <h3 class="pole__place">{where.to.place}</h3>
          <p class="pole__body">{where.to.body}</p>
        </div>
      </div>

      <p class="where__note">{where.note}</p>
    </div>
  </div>
</section>

<style>
  .where__map { position: relative; margin-top: clamp(2.125rem, 6vh, 4rem); }
  .where__arc { width: 100%; height: auto; display: block; overflow: visible; }
  .where__ghost {
    fill: none;
    stroke: var(--rule-quiet);
    stroke-width: 1.4;
    stroke-dasharray: 3 6;
  }
  .where__drawn {
    fill: none;
    stroke: var(--accent-fill);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .where__pin { fill: var(--ink); }
  .where__pin--end { fill: var(--accent-on-dark); }

  .where__poles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(var(--space-md), 4vw, 3.75rem);
    margin-top: var(--space-xs);
  }
  .pole__label {
    margin: 0;
    font-size: var(--step-utility);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-softer);
    max-width: none;
  }
  .pole__place {
    margin-top: var(--space-xs);
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.1rem);
    letter-spacing: -0.015em;
  }
  .pole__body { margin: var(--space-xs) 0 0; font-size: var(--step-body-sm); color: var(--text-soft); max-width: 26rem; }

  /* The second pole is set right so the pair reads as the two ends of the
     arc above them rather than as two left aligned cards. */
  .pole--end { text-align: right; justify-self: end; }
  .pole--end .pole__body { margin-left: auto; }

  .where__note {
    margin: clamp(1.875rem, 5vh, 3.375rem) 0 0;
    padding-top: var(--space-md);
    border-top: var(--hairline) solid var(--rule-quiet);
    font-size: var(--step-body-sm);
    color: var(--text-soft);
    max-width: var(--measure-wide);
  }

  @media (max-width: 40rem) {
    .pole--end { text-align: left; justify-self: start; }
    .pole--end .pole__body { margin-left: 0; }
  }
</style>
