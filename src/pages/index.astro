---
/**
 * The homepage. Two moments carry the motion: the hero, where the name parts
 * and an open book becomes a window onto a distribution, and the film, which
 * opens to the full screen on the same gesture. Everything between them
 * reveals as it arrives and otherwise stays out of the way.
 *
 * Every section is an ordinary flowing element with real text in it. Reduced
 * motion, a browser without JavaScript, and a screen reader all get the
 * complete page, finished, rather than a broken animation.
 */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import Work from '../components/home/Work.astro';
import Turn from '../components/home/Turn.astro';
import Film from '../components/home/Film.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import ImpactBand from '../components/home/ImpactBand.astro';
import ChapterModel from '../components/home/ChapterModel.astro';
import GetInvolved from '../components/home/GetInvolved.astro';
import Closing from '../components/home/Closing.astro';
import { org } from '../content/site.ts';
import { hero } from '../content/home.ts';
---
<Layout title={org.name} description={hero.standfirst} bare>
  <div class="home">
    <Hero />
    <Work />
    <Turn />
    <Film />
    <HowItWorks />
    <ImpactBand />
    <ChapterModel />
    <GetInvolved />
    <Closing />
  </div>
</Layout>

<style>
  .home {
    position: relative;
    isolation: isolate;
    /* `clip` rather than `hidden`: hidden would make this a scroll container
       and break the pinned sections. */
    overflow-x: clip;
    background: var(--paper);
  }
</style>
