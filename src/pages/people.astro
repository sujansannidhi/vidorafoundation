---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import TodoNote from '../components/TodoNote.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import { people, foundingNote } from '../content/people.ts';

/* The first person with a written bio leads the page. The rest are a grid
   of names, because a name with a placeholder under it is honest and a name
   with an invented bio under it is not. */
const [lead, ...rest] = people;
---
<Layout title="People" description="The team behind Vidora Foundation.">
  <PageHeader
    eyebrow="People"
    title="Run by high school students."
    standfirst={foundingNote}
  />

  <div class="shell">
    <article class="lead">
      <div class="lead__photo">
        <PhotoSlot
          subject={`Portrait, ${lead.name}`}
          photo={lead.photo}
          ratio="3 / 4"
        />
      </div>
      <div>
        <p class="eyebrow">{lead.role ?? 'Role not published yet'}</p>
        <h2 class="lead__name">{lead.name}</h2>
        {lead.bio
          ? lead.bio.map((para) => <p class="lead__para">{para}</p>)
          : <TodoNote item={1} what={`A short bio for ${lead.name}: where they come from, and what they do at Vidora. Not written yet, and not invented here.`} />}
        {lead.needsReview && (
          <p class="lead__review">
            This bio was assembled from previously published copy and is
            awaiting sign off.
          </p>
        )}
        <p class="lead__contact">
          {lead.email && <a href={`mailto:${lead.email}`}>{lead.email}</a>}
          {lead.linkedin && <a href={lead.linkedin} rel="noopener">LinkedIn</a>}
        </p>
      </div>
    </article>

    <ul class="team">
      {rest.map((person) => (
        <li class="member">
          <div class="member__photo">
            <PhotoSlot
              subject={`Portrait, ${person.name}`}
              photo={person.photo}
              ratio="1 / 1"
              label={false}
            />
          </div>
          <h2 class="member__name">{person.name}</h2>
          {person.role && <p class="eyebrow member__role">{person.role}</p>}
          {person.email && (
            <p class="member__contact">
              <a href={`mailto:${person.email}`}>{person.email}</a>
            </p>
          )}
          {person.bio
            ? person.bio.map((para) => <p class="member__para">{para}</p>)
            : <TodoNote item={1} what={`A bio and photo for ${person.name}. Not written yet, and not invented here.`} />}
          {person.bio && person.needsReview && (
            <p class="member__review">Awaiting sign off.</p>
          )}
        </li>
      ))}
    </ul>

  </div>
</Layout>

<style>
  .lead {
    border-top: var(--hairline) solid var(--rule-quiet);
    padding-top: clamp(1.75rem, 4vh, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.375rem, 3vw, 3rem);
  }
  .lead__photo { max-width: 360px; }
  .lead__name { margin-top: var(--space-sm); font-size: clamp(1.7rem, 1rem + 2vw, 2.4rem); }
  .lead__para { margin: var(--space-md) 0 0; max-width: 33rem; }
  .lead__review {
    margin-top: var(--space-md);
    font-size: var(--step-body-sm);
    color: var(--text-soft);
    padding-left: var(--space-md);
    border-left: var(--hairline) solid var(--rule-quiet);
  }

  .team {
    list-style: none;
    margin: clamp(2.75rem, 7vh, 5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--hairline);
    background: var(--rule-quiet);
  }
  .member { max-width: none; background: var(--paper-cool); padding: clamp(var(--space-md), 3vw, 2rem); }
  .member__photo { max-width: 120px; }
  .member__name { margin-top: var(--space-md); font-size: 1.3rem; }
  .member__role { margin-top: var(--space-2xs); }
  .member__para { margin: var(--space-xs) 0 0; font-size: var(--step-body-sm); color: var(--text-soft); }

  .lead__contact {
    margin-top: var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--step-body-sm);
  }
  .member__contact { margin: var(--space-xs) 0 0; font-size: var(--step-body-sm); }
  .member__review {
    margin: var(--space-sm) 0 0;
    font-size: var(--step-body-xs);
    color: var(--text-softer);
    padding-left: var(--space-sm);
    border-left: var(--hairline) solid var(--rule-quiet);
  }
  .member__contact a { overflow-wrap: anywhere; }

  @media (max-width: 48rem) {
    .lead { grid-template-columns: minmax(0, 1fr); }
  }
</style>
