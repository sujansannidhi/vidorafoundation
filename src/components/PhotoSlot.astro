---
/**
 * A photograph in a fixed frame.
 *
 * The frame owns the aspect ratio and the crop; the photograph fills it with
 * object-fit: cover. Every frame on the site now carries a real photograph,
 * so this renders no placeholder: a section with nothing to show leaves the
 * frame out and reflows around the gap rather than printing an empty box.
 * Gaps that still need stating are stated in words, by TodoNote.
 */
import type { Photo } from '../content/photos.ts';

interface Props {
  photo: Photo;
  /** CSS aspect-ratio for the frame. */
  ratio?: string;
  /**
   * How wide the frame actually renders, for picking a candidate from
   * `srcset`. Must match the breakpoint at which the frame's own grid goes
   * to one column, or phones are served a candidate too small for them.
   */
  sizes?: string;
  /**
   * `object-position`, for the few frames whose subject is not centred once
   * the slot ratio crops the photograph further.
   */
  position?: string;
  class?: string;
}

const {
  photo,
  ratio = '4 / 3',
  sizes = '(max-width: 40rem) calc(100vw - 2.25rem), 580px',
  position,
  class: className,
} = Astro.props;
---
<div class:list={['slot', className]} style={`aspect-ratio: ${ratio};`}>
  <img
    src={photo.src}
    srcset={photo.srcset}
    sizes={photo.srcset ? sizes : undefined}
    width={photo.width}
    height={photo.height}
    style={position ? `object-position: ${position};` : undefined}
    alt={photo.alt}
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .slot {
    position: relative;
    overflow: hidden;
  }
  .slot img { width: 100%; height: 100%; object-fit: cover; }
</style>
