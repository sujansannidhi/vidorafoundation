---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ImpactFigure from '../components/ImpactFigure.astro';
import {
  studentsWhoReceivedKits,
  schoolsReached,
  campaignCost,
} from '../content/impact.ts';
import { campaign } from '../content/campaign-june-2026.ts';
---
<Layout
  title="Impact"
  description="The three June 2026 figures, what each one counts, and what it does not."
>
  <PageHeader variant="dark" eyebrow="Impact" title="Three numbers, each counting one thing.">
    <div class="figures">
      <ImpactFigure figure={studentsWhoReceivedKits} />
      <ImpactFigure figure={schoolsReached} />
      <ImpactFigure figure={campaignCost} />
    </div>
  </PageHeader>

  <div class="shell">
    <a class="evidence" href={`/campaigns/${campaign.slug}`}>
      <p class="eyebrow">The evidence</p>
      <h2 class="evidence__heading">{campaign.title}, the full field report</h2>
      <p class="evidence__body">
        Written up in the order the work happened, ending with what we would do
        differently.
      </p>
    </a>
  </div>
</Layout>

<style>
  .figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1.75rem, 4vw, 3.375rem);
    margin-top: clamp(2.75rem, 7vh, 5rem);
  }

  .evidence {
    display: block;
    padding: clamp(1.625rem, 4vw, 2.75rem);
    border: var(--hairline) solid var(--rule-quiet);
    text-decoration: none;
    color: var(--text);
    transition: background-color var(--dur) var(--ease-out),
                border-color var(--dur) var(--ease-out);
  }
  .evidence:hover { background: var(--paper-cool); border-color: var(--ink); }
  .evidence__heading { margin-top: var(--space-sm); font-size: clamp(1.5rem, 1rem + 1.9vw, 2.2rem); }
  .evidence__heading::after { content: ' \2192'; }
  .evidence__body { margin: var(--space-sm) 0 0; max-width: 36rem; color: var(--text-soft); }
</style>
