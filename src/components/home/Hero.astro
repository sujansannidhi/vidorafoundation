---
/**
 * Section 01. Full viewport, bottom aligned, with the sunburst drawing
 * itself under the copy.
 *
 * The rays and the book arcs are the mark's own geometry, redrawn at scale
 * as line work. Drawing them rather than scaling up the PNG is what keeps
 * the brand rule intact: the mark itself is never stretched, and this is a
 * separate illustration that quotes it.
 */
import SectionIndex from '../SectionIndex.astro';
import { hero } from '../../content/home.ts';

/* Ray endpoints, mirrored either side of the spine at x=200, y=130.
   Held as data so the pairs cannot drift apart in the markup. */
const RAYS: [number, number, number][] = [
  [200, 8, 0.6],
  [168, 16, 0.66], [232, 16, 0.66],
  [138, 30, 0.72], [262, 30, 0.72],
  [110, 50, 0.78], [290, 50, 0.78],
  [86, 76, 0.84], [314, 76, 0.84],
  [70, 104, 0.9], [330, 104, 0.9],
];
---
<section class="hero" id={hero.id} aria-labelledby="hero-heading">
  <div class="shell hero__inner">
    <SectionIndex eyebrow={hero.eyebrow} index={hero.index} />

    <div class="hero__grid">
      <h1 id="hero-heading" class="hero__headline enter">
        {hero.headline}
        <em class="hero__emphasis">{hero.headlineEmphasis}</em>
      </h1>

      <div class="hero__read enter enter--late">
        <p class="hero__standfirst">{hero.standfirst}</p>
        <p class="hero__proof">{hero.proof}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</a>
          <a class="btn btn--secondary" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__figure" aria-hidden="true">
    <svg class="sunburst" viewBox="0 0 400 148" focusable="false">
      <g class="sunburst__rays">
        {RAYS.map(([x, y, delay]) => (
          <path d={`M200 130 L${x} ${y}`} style={`animation-delay: ${delay}s;`} />
        ))}
      </g>
      <g class="sunburst__book">
        <path class="page page--outer" pathLength="1000" d="M4 140 C 88 96 158 92 198 128" />
        <path class="page page--outer" pathLength="1000" d="M396 140 C 312 96 242 92 202 128" />
        <path class="page page--inner" pathLength="1000" d="M58 128 C 118 104 168 104 198 122" />
        <path class="page page--inner" pathLength="1000" d="M342 128 C 282 104 232 104 202 122" />
      </g>
    </svg>
    <p class="hero__cue">{hero.scrollCue}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: clamp(2.5rem, 7vh, 5.625rem);
    overflow: hidden;
  }
  .hero__inner { position: relative; z-index: 2; }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(1.625rem, 4vw, 3.75rem);
    margin-top: clamp(1.75rem, 5vh, 3.625rem);
  }
  .hero__headline {
    line-height: 1.03;
    max-width: 19ch;
  }
  .hero__emphasis {
    display: inline-block;
    margin-top: 0.18em;
    font-style: italic;
    color: var(--link);
  }

  .hero__read { display: grid; gap: var(--space-md); align-content: start; margin-top: 18px; }
  .hero__standfirst {
    margin: 0;
    font-size: var(--step-body-lg);
    max-width: 33rem;
    color: var(--text);
  }
  .hero__proof {
    margin: 0;
    font-size: var(--step-body-sm);
    max-width: 31rem;
    padding-left: var(--space-md);
    border-left: 2px solid var(--accent-on-dark);
    color: var(--text-soft);
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-2xs); }

  /* ---- The drawn sunburst ---- */
  .hero__figure {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--shell);
    margin-inline: auto;
    margin-top: clamp(1.25rem, 4vh, 2.75rem);
    pointer-events: none;
  }
  .sunburst {
    display: block;
    width: min(100%, 780px);
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }
  .sunburst__rays path {
    fill: none;
    stroke: var(--accent-on-dark);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 120;
  }
  .sunburst__book .page {
    fill: none;
    stroke-linecap: round;
    stroke-dasharray: 1000;
  }
  .page--outer { stroke: var(--accent-fill); stroke-width: 5; }
  .page--inner { stroke: var(--accent-on-dark); stroke-width: 3.4; }

  @media (prefers-reduced-motion: no-preference) {
    .sunburst__rays path { animation: ray-in 0.8s var(--ease-out) both; }
    .sunburst__book .page { animation: draw 1.1s var(--ease-out) both; }
    .page--outer { animation-delay: 0.34s; }
    .page--inner { animation-delay: 0.48s; }
  }

  .hero__cue {
    margin: 0;
    padding: var(--space-sm) 0 var(--space-md);
    text-align: center;
    font-size: var(--step-utility-sm);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-softer);
    max-width: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__cue { animation: scroll-cue 2.6s ease-in-out 1.6s infinite; }
  }

  @media (max-width: 56.25rem) {
    .hero__grid { grid-template-columns: minmax(0, 1fr); }
    .hero__read { margin-top: 0; }
  }
</style>
