---
/**
 * The June 2026 film, given the page's second big moment.
 *
 * On a wide screen the section pins and the framed film widens until it
 * fills the screen, the same move the hero makes with its photograph, so
 * the page opens and peaks on the same gesture. It plays muted and looped
 * while it is on screen; one button restarts it with sound and controls.
 *
 * Fallbacks, in the order they matter:
 *
 * 1. Without JavaScript the <video> carries `controls` and `preload="none"`:
 *    a poster until somebody presses play, then the browser's own player.
 * 2. With reduced motion, or the browser asking to save data, nothing plays
 *    by itself and nothing pins. The film waits for the button.
 * 3. Nothing is downloaded until the film is about to come on screen. The
 *    file is 7.8 MB, and most readers on a phone will not watch it.
 *
 * The clip is the original promotional video cut at 19.0s: everything after
 * that is an end card carrying an earlier name for the organisation, its
 * mark, and a domain this site does not use. The poster is the frame at
 * 17.6s.
 */
import SectionIndex from '../SectionIndex.astro';
import { film } from '../../content/home.ts';

const POSTER = '/media/distribution-film-poster.jpg';
---
<section class="band film" id={film.id} aria-labelledby="film-heading" data-film>
  <div class="shell film__head">
    <SectionIndex eyebrow={film.eyebrow} />
    <div class="film__intro">
      <h2 id="film-heading" class="film__headline" data-film-reveal>{film.headline}</h2>
      <p class="film__standfirst" data-film-reveal>{film.standfirst}</p>
    </div>
  </div>

  <div class="film__pin" data-film-pin>
    <figure class="film__figure">
      <div class="film__frame" data-film-frame>
        <video
          class="film__video"
          src={film.src}
          poster={POSTER}
          preload="none"
          playsinline
          controls
          width="1280"
          height="720"
          aria-label={film.playLabel}
          data-film-video
        ></video>
        <div class="film__shade" aria-hidden="true"></div>
        <button class="film__sound" type="button" hidden data-film-sound>
          <span class="film__sound-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M4 9h4l5-4v14l-5-4H4z" />
              <path class="film__wave" d="M16.5 8.5a5 5 0 0 1 0 7" />
              <path class="film__wave" d="M19 6a8.5 8.5 0 0 1 0 12" />
            </svg>
          </span>
          <span data-film-sound-label>{film.soundOn}</span>
        </button>
      </div>
      <figcaption class="film__caption shell">{film.caption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .film { position: relative; z-index: 1; padding-bottom: var(--section-y); }

  .film__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(var(--space-md), 4vw, 4rem);
    align-items: end;
    margin-top: var(--space-lg);
  }
  .film__headline { max-width: 18ch; font-size: var(--step-display-1); }
  .film__standfirst {
    margin: 0;
    max-width: 30rem;
    font-size: var(--step-body-lg);
    color: var(--text-soft);
  }

  .film__pin { margin-top: clamp(2.5rem, 7vh, 4.5rem); }
  .film__figure { margin: 0; }

  .film__frame {
    position: relative;
    width: min(calc(100% - 2 * var(--gutter)), var(--shell));
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--plum-deep);
  }
  .film__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--plum-deep);
  }
  /* Only there to keep the button legible over a bright frame. */
  .film__shade {
    position: absolute;
    inset: auto 0 0 0;
    height: 40%;
    background: linear-gradient(to top, rgb(11 30 50 / 0.55), var(--plum-deep-fade));
    pointer-events: none;
    opacity: 0;
  }

  .film__sound {
    position: absolute;
    left: clamp(0.75rem, 2.5vw, 1.75rem);
    bottom: clamp(0.75rem, 2.5vw, 1.75rem);
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: 44px;
    padding: 0.7em 1.2em 0.7em 0.9em;
    font: inherit;
    font-size: var(--step-utility);
    font-weight: 700;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--paper);
    background: rgb(11 30 50 / 0.62);
    border: var(--hairline) solid rgb(250 247 242 / 0.5);
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition: background-color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }
  .film__sound:hover,
  .film__sound:focus-visible { background: var(--accent-fill); border-color: var(--accent-fill); }
  .film__sound-icon svg {
    display: block;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .film__sound-icon path:first-child { fill: currentColor; }
  .film__sound[data-on='true'] .film__wave { opacity: 0.35; }
  .film__sound[data-on='false'] .film__wave { opacity: 1; }
  .film__sound[hidden] { display: none; }

  .film__caption {
    margin-top: var(--space-sm);
    font-size: var(--step-utility);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
    color: var(--text-softer);
  }

  @media (max-width: 48rem) {
    .film__intro { grid-template-columns: minmax(0, 1fr); }
    /* On a small video the button is just the speaker; the label stays for
       screen readers. */
    .film__sound { width: 44px; padding: 0; justify-content: center; }
    .film__sound [data-film-sound-label] {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  /* Wide screens, with motion: the frame is the full screen, clipped back to
     the framed size, and the script opens the clip as the page scrolls. */
  @media (min-width: 48.01rem) {
    :global(html.motion) .film__pin {
      height: 100svh;
      display: grid;
      align-items: center;
    }
    :global(html.motion) .film__frame {
      width: 100%;
      height: 100svh;
      aspect-ratio: auto;
      will-change: clip-path;
    }
    :global(html.motion) .film__caption { display: none; }
  }
  :global(html.motion) .film__shade { opacity: 1; }
</style>

<script>
  import { gsap, startSmoothScroll, motionAllowed } from '../../scripts/home-motion.ts';
  import { film } from '../../content/home.ts';

  const root = document.querySelector<HTMLElement>('[data-film]');
  const video = root?.querySelector<HTMLVideoElement>('[data-film-video]');
  const sound = root?.querySelector<HTMLButtonElement>('[data-film-sound]');
  const soundLabel = root?.querySelector<HTMLElement>('[data-film-sound-label]');

  type SaveDataConnection = { saveData?: boolean };
  const saveData = (navigator as Navigator & { connection?: SaveDataConnection }).connection?.saveData === true;
  const ambient = motionAllowed() && !saveData;

  if (root && video && sound && soundLabel) {
    /* ---- Playback ---- */
    let withSound = false;
    const setSound = (on: boolean) => {
      withSound = on;
      video.muted = !on;
      video.controls = on;
      // The label says what pressing will do. No aria-pressed as well: a
      // changing label that is also "pressed" reads as "Mute, pressed".
      sound.dataset.on = String(on);
      soundLabel.textContent = on ? film.soundOff : film.soundOn;
    };

    if (ambient) {
      // Muted, looping and silent until asked: the browser's controls would
      // only sit over the picture, so the one button replaces them.
      video.controls = false;
      video.muted = true;
      // Looped by hand rather than with `loop`: the clip cuts to black from
      // about 2.0s to 2.9s, and played silently on repeat that blank second
      // is what the full-screen reveal would land on. The silent loop runs
      // from 3.0s; with sound on, the film plays whole from the start.
      video.loop = false;
      video.removeAttribute('aria-label');
      video.setAttribute('aria-hidden', 'true');
      sound.hidden = false;
      setSound(false);

      // Fetch just before the film arrives, play only while it is on screen.
      const near = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        video.preload = 'auto';
        near.disconnect();
      }, { rootMargin: '600px 0px' });
      near.observe(video);

      const AMBIENT_FROM = 3;
      video.addEventListener('loadedmetadata', () => {
        if (!withSound) video.currentTime = AMBIENT_FROM;
      }, { once: true });
      video.addEventListener('ended', () => {
        if (withSound) return;
        video.currentTime = AMBIENT_FROM;
        video.play().catch(() => {});
      });

      const onScreen = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) video.play().catch(() => {});
          else if (!withSound) video.pause();
        }
      }, { threshold: 0.25 });
      onScreen.observe(video);

      sound.addEventListener('click', () => {
        if (withSound) {
          setSound(false);
          video.removeAttribute('aria-label');
          video.setAttribute('aria-hidden', 'true');
        } else {
          // Start from the top when sound comes on, so it is heard whole.
          setSound(true);
          video.currentTime = 0;
          video.play().catch(() => {});
          video.removeAttribute('aria-hidden');
          video.setAttribute('aria-label', film.playLabel);
        }
      });
    }

    /* ---- Motion ---- */
    if (motionAllowed()) {
      const lenis = startSmoothScroll();
      const pin = root.querySelector<HTMLElement>('[data-film-pin]')!;
      const frame = root.querySelector<HTMLElement>('[data-film-frame]')!;

      gsap.from(root.querySelectorAll('[data-film-reveal]'), {
        y: 36, opacity: 0, filter: 'blur(8px)', duration: 1.2, ease: 'expo.out', stagger: 0.12,
        clearProps: 'filter',
        scrollTrigger: { trigger: root, start: 'top 75%', once: true },
      });

      const mm = gsap.matchMedia();
      mm.add('(min-width: 48.01rem)', () => {
        /** The framed size, as an inset on the full-screen frame. */
        const framed = () => {
          const vw = window.innerWidth;
          const vh = window.innerHeight;
          const gutter = Math.max(18, Math.min(44, vw * 0.04));
          const w = Math.min(vw - 2 * gutter, 1240) * 0.86;
          const h = Math.min(w * 9 / 16, vh * 0.72);
          const ww = h * 16 / 9;
          const x = (vw - ww) / 2;
          const y = (vh - h) / 2;
          return `inset(${y}px ${x}px ${y}px ${x}px round 6px)`;
        };

        const tl = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: pin,
            start: 'top top',
            end: () => `+=${window.innerHeight * 1.5}`,
            pin: true,
            scrub: 1,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });
        tl.fromTo(frame, { clipPath: framed }, { clipPath: 'inset(0px 0px 0px 0px round 0px)', duration: 3, ease: 'power2.inOut' })
          .fromTo(video, { scale: 1.18 }, { scale: 1, duration: 3, ease: 'power1.out' }, 0)
          // The button is placed for the open frame; while the frame is
          // still clipped it would show as a sliver along the bottom edge.
          // Opacity only, not visibility, so the button stays in the tab order.
          .fromTo(sound, { opacity: 0 }, { opacity: 1, duration: 0.4 }, 2.6)
          .to({}, { duration: 1 });

        /* Tabbing to the button before the film has opened carries the page
           to the point where it has, so focus never lands on something
           transparent. */
        const onFocus = () => {
          const st = tl.scrollTrigger;
          if (st && window.scrollY < st.end - 2) lenis?.scrollTo(st.end - window.innerHeight * 0.1, { immediate: true });
        };
        sound.addEventListener('focus', onFocus);

        return () => {
          sound.removeEventListener('focus', onFocus);
          tl.kill();
        };
      });

      // Phones do not pin: the frame rises and opens as it arrives instead.
      mm.add('(max-width: 48rem)', () => {
        const t = gsap.fromTo(root.querySelector('[data-film-frame]'),
          { clipPath: 'inset(8% 6% 8% 6%)', y: 30 },
          { clipPath: 'inset(0% 0% 0% 0%)', y: 0, ease: 'none',
            scrollTrigger: { trigger: frame, start: 'top 95%', end: 'top 45%', scrub: 0.8 } });
        return () => t.kill();
      });
    }
  }
</script>
