---
/**
 * Ordered by what the organisation actually needs, which is why starting a
 * chapter gets the whole first block and everything else is arranged beneath
 * it. Four equal cards would say the four are equally useful, and they are
 * not.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PendingStatus from '../components/PendingStatus.astro';
import { todos } from '../content/site.ts';
import { joinOpenPaths } from '../content/volunteer.ts';

---
<Layout title="Get involved" description="Start a chapter, volunteer, fundraise, or donate.">
  <PageHeader
    variant="dark"
    eyebrow="Get involved"
    title="Start where you can."
    standfirst="Start a chapter, volunteer, fundraise or give. Every bit helps a student start the year ready."
  />

  <div class="shell">
    <article class="feature" id="chapter">
      <p class="eyebrow">Most needed</p>
      <h2 class="feature__heading">Start a chapter</h2>
      <p class="feature__body">
        A chapter is a group at one high school that raises for and runs a
        distribution. One chapter can supply a school.
      </p>
      {todos.chapterProcess && <p>{todos.chapterProcess}</p>}
      {todos.chapterFormUrl && (
        <a
          class="btn btn--accent feature__cta"
          href={todos.chapterFormUrl}
          rel="noopener"
        >Apply to start a chapter</a>
      )}
    </article>

    <section class="volunteer" id="volunteer" aria-labelledby="volunteer-heading">
      <p class="eyebrow">{joinOpenPaths.eyebrow}</p>
      <h2 id="volunteer-heading" class="volunteer__heading">{joinOpenPaths.heading}</h2>
      <p class="volunteer__body">{joinOpenPaths.body}</p>
      <ul class="volunteer__labels">
        {joinOpenPaths.labels.map((l) => <li>{l}</li>)}
      </ul>
      <a class="btn btn--accent volunteer__cta" href={joinOpenPaths.href}>{joinOpenPaths.cta}</a>
    </section>

    <div class="also">
      <article class="also__item" id="fundraise">
        <h2 class="also__heading">Fundraise</h2>
        <p class="also__body">
          Raise what a school's kits cost. Supplies are bought local to the
          school receiving them, so the cost per kit reflects prices where it
          is going rather than prices where the money was raised.
        </p>
      </article>

      <article class="also__item" id="donate">
        <h2 class="also__heading">Donate</h2>
        <p class="also__body">
          Money buys educational materials at local prices, near the school
          receiving them.
        </p>
        <a class="link-action" href="/donate">Go to donate</a>
      </article>
    </div>

    <PendingStatus />
  </div>
</Layout>

<style>
  .feature { border: var(--hairline) solid var(--accent-fill); padding: clamp(1.75rem, 4vw, 3.375rem); }
  .feature__heading { margin-top: var(--space-sm); max-width: 20ch; font-size: clamp(1.8rem, 1rem + 2.8vw, 2.9rem); }
  .feature__body { margin: var(--space-md) 0 0; max-width: 34rem; font-size: var(--step-body-lg); }
  .feature__cta { margin-top: var(--space-lg); }

  /* ---- Volunteer, as its own section rather than one card among four ---- */
  .volunteer {
    margin-top: clamp(2.5rem, 7vh, 4.5rem);
    padding-top: var(--space-md);
    border-top: 0;
  }
  .volunteer__heading { margin-top: var(--space-sm); font-size: clamp(1.7rem, 1rem + 2.4vw, 2.5rem); }
  .volunteer__body { margin: var(--space-sm) 0 0; max-width: 36rem; color: var(--text-soft); }

  .volunteer__cta { margin-top: var(--space-lg); }
  .volunteer__labels { display: flex; flex-wrap: wrap; gap: var(--space-xs); list-style: none; margin: var(--space-md) 0 0; padding: 0; }
  .volunteer__labels li {
    max-width: none;
    padding: 0.35em 0.9em;
    border: var(--hairline) solid var(--rule-quiet);
    font-size: var(--step-utility);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
    font-weight: 700;
  }

  /* ---- The quieter two ---- */
  .also {
    margin-top: clamp(2.5rem, 7vh, 4.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--hairline);
    background: var(--rule-quiet);
  }
  .also__item { background: var(--paper-cool); padding: clamp(var(--space-md), 3vw, 2.375rem); }
  .also__heading { font-size: 1.6rem; letter-spacing: -0.014em; }
  .also__body { margin: var(--space-sm) 0 var(--space-sm); font-size: var(--step-body-sm); }

  @media (max-width: 52rem) {
    }
  @media (max-width: 40rem) {
    }
</style>
