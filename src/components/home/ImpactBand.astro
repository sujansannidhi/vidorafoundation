---
/**
 * The three June 2026 figures on navy.
 *
 * Three separate named imports, rendered by three separate elements. There
 * is no array here to map over, which is the structural reason no code path
 * on this page can sum them. Plan section 8, rule 1.
 */
import SectionIndex from '../SectionIndex.astro';
import ImpactFigure from '../ImpactFigure.astro';
import { impactSection } from '../../content/home.ts';
import { campaign } from '../../content/campaign-june-2026.ts';
import {
  studentsWhoReceivedKits,
  schoolsReached,
  campaignCost,
} from '../../content/impact.ts';
---
<section class="band band--tall on-dark impact-band" id={impactSection.id} aria-labelledby="impact-heading">
  <div class="shell">
    <SectionIndex eyebrow={impactSection.eyebrow} />
    <h2 id="impact-heading" class="impact-band__headline">{impactSection.headline}</h2>

    <div class="impact-band__figures">
      <ImpactFigure figure={studentsWhoReceivedKits} />
      <ImpactFigure figure={schoolsReached} />
      <ImpactFigure figure={campaignCost} />
    </div>


    <a class="link-action impact-band__evidence" href={`/campaigns/${campaign.slug}`}>
      Read the June 2026 field report
    </a>
  </div>
</section>

<style>
  .impact-band__headline { margin-top: var(--space-lg); max-width: 22ch; }
  .impact-band__figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(1.875rem, 4vw, 3.5rem);
    margin-top: clamp(2.75rem, 7vh, 5.375rem);
  }
  .impact-band__evidence { margin-top: clamp(var(--space-lg), 5vh, var(--space-xl)); }
</style>
